<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Polaire</RootNamespace>
    <AssemblyName>Polaire</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Polaire</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Apache Arrow for columnar data foundation -->
    <PackageReference Include="Apache.Arrow" Version="18.0.0" />

    <!-- High-performance memory management -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />

    <!-- Parquet file support -->
    <PackageReference Include="Parquet.Net" Version="5.0.2" />

    <!-- JSON support -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />

    <!-- CSV parsing -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />

    <!-- Memory pooling and allocation -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="8.0.11" />

    <!-- SQL parsing -->
    <PackageReference Include="SqlParser" Version="0.5.0" />
  </ItemGroup>
</Project>
